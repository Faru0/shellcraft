# ── Start something in the background ───────────────────────────────────────
# It shows in the footer; Ctrl-] N switches to it.
# sub find ~/projects -name "*.log" -mtime -1

# ── Split your setup into several files ─────────────────────────────────────
# Files ending in .sc in ~/.shellcraft/startup/ run automatically after this one, in name order:
# one file per job (10-vpn.sc, 20-project.sc). See startup/README.txt there.
# You can also pull in a file yourself; one that doesn't exist is skipped:
# [ -f ~/.shellcraft/rc.work ] && source ~/.shellcraft/rc.work

