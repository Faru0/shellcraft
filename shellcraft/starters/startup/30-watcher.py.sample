# How to use this file
# --------------------
# This is an example background startup script. It doesn't run while its name ends in .sample.
# To use it, copy it to a name ending in .py:
#
#     cp 30-watcher.py.sample 30-watcher.py
#
# The `# shellcraft: background, restart` line below is what makes it a background script:
#   background  it starts as a subshell once the prompt is ready, so the shell never waits for it.
#               It shows in the footer as `startup: 30-watcher.py` (Ctrl-] and its number to look,
#               Ctrl-] x to end it).
#   restart     if it crashes it starts again, giving up after 5 crashes in 10 minutes.
# A background script can't set variables for the shell; put those in a normal startup script.
# It can send alerts: the `alert` command is on its PATH.
#
# Inside ShellCraft: `startup stop NAME`, `startup start NAME`, `startup restart NAME`.
# More: `man startup`, or docs/startup.md.
#
# shellcraft: background, restart

import os
import subprocess
import time

watched = os.path.expanduser(os.environ.get("WATCH_DIR", "~"))
subprocess.run(["alert", "-l", "info", f"watching {watched}"], check=False)

seen = set(os.listdir(watched))
while True:
    time.sleep(5)
    now = set(os.listdir(watched))
    for name in sorted(now - seen):
        print(f"new: {name}", flush=True)
        subprocess.run(["alert", f"new file in {watched}: {name}"], check=False)
    seen = now
