# How to use this file
# --------------------
# ~/.shellcraft/aliases holds your shortcuts, one per line, written like ~/.bash_aliases in bash:
#     alias NAME='COMMAND'
# An alias replaces the first word of a command; anything you type after it is added at the end.
#
# Lines starting with # are comments. Remove the # in front of a line below to use it. A note after
# an alias works too, with a space before and after the #:
#     alias ll='ls -l'   # long listing
# Changes apply to the next command you type: no restart needed.
#
# From the prompt, `alias NAME='COMMAND'` adds a line here and `unalias NAME` removes it.
# A leading backslash skips an alias for one command: \ls
# More: `man alias`, or docs/aliases-and-history.md.

# alias ll='ls -l'
# alias la='ls -a -l'
# alias errors='grep -i error'
# alias today='date +%Y-%m-%d'
# alias myjson='curl -s -H "Accept: application/json"'
