# ShellCraft skill file (TOML). Parsed at startup and injected into the MCP tool description.

summary = "Filter text line by line with a regular expression (grep-style) and return the matching lines."

when_to_use = """
Use after obtaining text (e.g. from `fetch`) when you need only the relevant lines: log lines
with a keyword, CSV rows matching a value, or a count of occurrences. Prefer this over reading a
whole large document yourself. Put the text to search in `stdin`; this tool never reads files."""

usage = "filter [-i] [-v] [-c] [-n] [-F] [-m N] PATTERN"

examples = [
  '{"pattern": "error", "ignore_case": true, "stdin": "<log text>"}',
  '{"pattern": "^GET ", "count": true, "stdin": "<access log>"}',
  '{"pattern": "#", "invert": true, "fixed": true, "stdin": "<config file text>"}',
]

notes = """
An empty result means no line matched (not an error). An invalid regex returns a tool error;
retry with `fixed` for literal text."""

[[params]]
name = "pattern"
metavar = "PATTERN"
required = true
description = "Python regular expression (or literal text with `fixed`)."

[[params]]
name = "ignore_case"
flag = "--ignore-case"
short = "-i"
type = "boolean"
description = "Case-insensitive."

[[params]]
name = "invert"
flag = "--invert"
short = "-v"
type = "boolean"
description = "Invert: return lines that do NOT match."

[[params]]
name = "count"
flag = "--count"
short = "-c"
type = "boolean"
description = "Return only the count of matching lines."

[[params]]
name = "line_number"
flag = "--line-number"
short = "-n"
type = "boolean"
description = "Prefix lines with their 1-based line number as 'N:line'."

[[params]]
name = "fixed"
flag = "--fixed"
short = "-F"
type = "boolean"
description = "Treat the pattern as a literal string (no regex metacharacters)."

[[params]]
name = "max"
flag = "--max"
short = "-m"
type = "integer"
metavar = "N"
description = "Stop after N matches."

# Tests: run by tools/modtest.py, never shown to the AI.
[[tests]]
args = ["-i", "b"]
stdin = "apple\nBanana\ncherry\n"
expect = "Banana\n"

[[tests]]
args = ["-c", "an"]
stdin = "apple\nbanana\nmango\n"
expect = "2\n"

[[tests]]
args = ["-n", "-v", "an"]
stdin = "apple\nbanana\n"
expect = "1:apple\n"

[[tests]]
args = ["("]
stdin = "x"
error = "invalid pattern"

[[tests]]
params = {pattern = "b", ignore_case = true}
stdin = "apple\nBanana\ncherry\n"
expect = "Banana\n"
