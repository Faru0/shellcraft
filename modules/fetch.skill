# ShellCraft skill file (TOML). Parsed at startup and injected into the MCP tool description.

summary = "Fetch text from an http(s) URL or a local file and return it as the tool output."

when_to_use = """
Use as the first step whenever you need the contents of a web page, a JSON API response, or a
file on the ShellCraft host. Use --json to pull one field out of a JSON document instead of
returning the whole payload, and --head to limit large outputs before sending them on.
Do not use it to write files; it only reads."""

usage = "fetch [SOURCE] [--head N] [--json PATH] [--timeout SECONDS]"

examples = [
  '{"source": "https://example.com", "head": 20}',
  '{"source": "package.json", "json": "dependencies"}',
  '{"source": "https://api.example.com/items", "method": "POST", "header": ["Authorization: Bearer <token>"], "data": "{\"name\": \"x\"}"}',
  '{"source": "https://api.github.com/repos/python/cpython", "json": "stargazers_count", "retry": 2}',
]

notes = """
Output is plain text. Pass it as `stdin` to `filter` (or use the shellcraft_pipeline tool with
'fetch SOURCE | filter PATTERN') to narrow it down. Errors (missing file, HTTP error, bad JSON)
come back as tool errors with a one-line explanation.
Binary content (images, PDFs, archives, anything with NUL bytes) is rejected with a tool error:
this tool only returns text."""

[[params]]
name = "source"
metavar = "SOURCE"
description = "http(s) URL or file path relative to the server's working directory. Omit (or '-') to echo `stdin`."

[[params]]
name = "head"
flag = "--head"
type = "integer"
metavar = "N"
description = "Return only the first N lines."

[[params]]
name = "json"
flag = "--json"
metavar = "PATH"
description = "Dotted path into parsed JSON, e.g. 'data.items.0.name'. Lists of scalars are returned one per line."

[[params]]
name = "header"
flag = "--header"
short = "-H"
type = "array"
metavar = "'NAME: VALUE'"
description = "Request header as 'Name: value' (URLs only); one item per header."

[[params]]
name = "method"
flag = "--method"
short = "-X"
metavar = "METHOD"
values = ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
description = "HTTP method (URLs only). Default GET, or POST when `data` is given."

[[params]]
name = "data"
flag = "--data"
short = "-d"
metavar = "DATA"
description = "Request body (URLs only): text, '@FILE' to send a file, or '@-' to send `stdin`. JSON bodies get Content-Type application/json, others form-urlencoded, unless a header sets it."

[[params]]
name = "retry"
flag = "--retry"
type = "integer"
metavar = "N"
description = "Retry up to N times on connection errors, timeouts and HTTP 408/425/429/5xx, waiting 1s, 2s, 4s... (or the server's Retry-After)."

[[params]]
name = "max_size"
flag = "--max-size"
metavar = "SIZE"
description = "Largest response or file to accept, e.g. 500K or 10M (default 10M); 0 for no limit."

[[params]]
name = "timeout"
flag = "--timeout"
type = "number"
metavar = "SECONDS"
description = "Network timeout in seconds (default 15)."

# Tests: run by tools/modtest.py, never shown to the AI.
[[tests]]
args = ["--head", "1"]
stdin = "first\nsecond\n"
expect = "first\n"

[[tests]]
args = ["--json", "user.name"]
stdin = '{"user": {"name": "ada"}}'
expect = "ada\n"

[[tests]]
args = ["--json", "a"]
stdin = "not json"
error = "not valid JSON"

[[tests]]
args = ["no-such-file.txt"]
error = "no such file"
