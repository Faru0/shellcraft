# ShellCraft skill file (TOML). Read for Tab completion, `man` and the module checker.
# fetch is curl under another name: AI clients get the `curl` tool instead, so this one is local.
expose = false

summary = "curl under another name, that also reads a local file or stdin; --head N keeps the first N lines."

when_to_use = """
At the prompt and in scripts: read a URL, a file or stdin into a pipeline, keeping the first lines
with --head N or one JSON field with --jq. AI clients use the curl tool."""

examples = [
  '{"source": ["https://example.com"], "head": 20}',
  '{"source": ["package.json"], "jq": "dependencies"}',
]

usage = "fetch [SOURCE...] [--head N] [--jq PATH] [any curl option]"

[[params]]
name = "head"
flag = "--head"
type = "integer"
metavar = "N"
description = "Keep only the first N lines (curl's --head, a HEAD request, is `-I` here)."

[[params]]
name = "jq"
flag = "--jq"
metavar = "PATH"
description = "Print one field of a JSON document: 'data.items.0.name' or '.data.items[0].name'."

[[params]]
name = "header"
flag = "--header"
short = "-H"
type = "array"
metavar = "'NAME: VALUE'"
description = "Request header as 'Name: value' (URLs only)."

[[params]]
name = "method"
flag = "--request"
short = "-X"
metavar = "METHOD"
description = "HTTP method (URLs only)."

[[params]]
name = "data"
flag = "--data"
short = "-d"
metavar = "DATA"
description = "Request body: text, '@FILE' or '@-' for stdin."

[[params]]
name = "max_size"
flag = "--max-size"
metavar = "SIZE"
description = "Largest response or file to accept, e.g. 500K or 10M (default 10M); 0 for no limit."

[[params]]
name = "source"
type = "array"
metavar = "SOURCE"
description = "URLs or local files; none (or '-') reads stdin."

# Tests: run by `python tools/ingest check`.
[[tests]]
args = ["--head", "1"]
stdin = "first\nsecond\n"
expect = "first\n"

[[tests]]
args = ["--jq", "user.name"]
stdin = '{"user": {"name": "ada"}}'
expect = "ada\n"

[[tests]]
args = ["--json", "user.name"]
stdin = '{"user": {"name": "ada"}}'
expect = "ada\n"

[[tests]]
args = ["--jq", "a"]
stdin = "not json"
error = "not valid JSON"

[[tests]]
args = ["no-such-file.txt"]
error = "no such file"
