# ShellCraft startup template: copy it to ~/.shellcraft/rc and edit it.
#   cp templates/startup/rc.template ~/.shellcraft/rc
# Every line runs when the shell starts, as if you typed it at the prompt.

# 1. Ask a simple question; the answer is $name from here on
name = input("What is your name? ")

# 2. Set environment variables: modules, subshells and programs all see them, and `env` lists
#    them (env -a shows the whole environment). -s marks a secret: asked once, kept in the keyring.
env set GREETING="Welcome back, $name"
echo $GREETING
# env set -s GITHUB_TOKEN

# 3. Run a module: your public IP
myip

# 4. Pull in other rc files, one per use case (like ~/.bash_aliases in bash).
#    A file that doesn't exist is skipped. Copy templates/startup/rc.work to try it.
#    The bash way, with an if block and `.` (short for source):
if [ -f ~/.shellcraft/rc.work ]; then
    . ~/.shellcraft/rc.work
fi
#    The short form, on one line:
[ -f ~/.shellcraft/rc.home ] && source ~/.shellcraft/rc.home
#    A whole folder, in name order (10-git.rc, 20-servers.rc …):
for f in ~/.shellcraft/rc.d/*.rc; do [ -f "$f" ] && source "$f"; done

# 5. A loop: count down from 3
for n in 3 2 1; do echo "starting in $n..."; done
echo "ready!"
