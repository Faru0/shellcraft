# ShellCraft startup template: copy it to ~/.shellcraft/rc and edit it.
#   cp templates/startup/rc.template ~/.shellcraft/rc
# Every line runs when the shell starts, as if you typed it at the prompt.

# 1. Ask a simple question; the answer is $name from here on
name = input("What is your name? ")

# 2. Set an environment variable: the shell, subshells and programs all see it
export GREETING="Welcome back, $name"
echo $GREETING

# 3. Run a module: your public IP
myip

# 4. A loop: count down from 3
for n in 3 2 1; do echo "starting in $n..."; done
echo "ready!"
