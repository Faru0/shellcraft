# Example ShellCraft startup file: copy it to ~/.shellcraft/rc and edit it.
#
# Each line runs as if you typed it at the prompt when the interactive shell starts (never for
# --mcp / --mcp-http). Builtins, modules, aliases, export, cd, theme, sub, alert, and for / if
# blocks over several lines all work. A line that fails is reported with its line number and the
# next one still runs. `source ~/.shellcraft/rc` runs it again; `man startup` has the details.

# Look and place
theme nord
cd ~

# Variables for everything started from this shell (subshells, modules, programs)
export PROJECT_ROOT=~/projects
export DEPLOY_ENV=staging

# Kick things off in the background: they show in the subshell panel (Ctrl-] N to look)
# sub find ~/projects -name "*.log" -mtime -1
# sub queryDns example.com

# Ask something, Python style; the answer is $name from here on
# name = input("What is your name? ")
# read -s -p "API token: " token

# Say hello
alert -l info "shell ready"
