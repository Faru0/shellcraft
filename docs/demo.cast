                                                                               \r\u001b[99C\u001b[0;38;2;122;92;153m\u2502\u001b[0m\r\r\n\u001b[0;48;2;39;40;34m \u001b[0;38;2;248;248;242;48;2;39;40;34mjq [FILE]                       pretty-print, with a line saying what the data is and how to dig \u001b[0;48;2;39;40;34m \r\u001b[99C\u001b[0;38;2;122;92;153m\u2502\u001b[0m\r\r\n\u001b[0;48;2;39;40;34m \u001b[0;38;2;248;248;242;48;2;39;40;34min\u001b[0;48;2;39;40;34m                                                                                                \r\u001b[99C\u001b[0;38;2;122;92;153m\u2502\u001b[0m\r\r\n\u001b[0;48;2;39;40;34m \u001b[0;38;2;248;248;242;48;2;39;40;34mjq [FILE] -s                    just that: the shape, and for deep data an outline of its nesting\u001b[0;48;2;39;40;34m \r\u001b[99C\u001b[0;38;2;122;92;153m\u2502\u001b[0m\r\r\n\u001b[0;48;2;39;40;34m \u001b[0;38;2;248;248;242;48;2;39;40;34mjq [FILE] [3]                   element 3 of a list (a path on its own works like -f)\u001b[0;48;2;39;40;34m             \r\u001b[99C\u001b[0;38;2;122;92;153m\u2502\u001b[0m\r\r\n\u001b[0;48;2;39;40;34m \u001b[0;38;2;248;248;242;48;2;39;40;34mjq [FILE] -f FILTER             pick a value: -f ['name'], -f [5]['name'], -f .items[0].id\u001b[0;48;2;39;40;34m        \r\u001b[99C\u001b[0;38;2;122;92;153m\u2502\u001b[0m\r\r\n\u001b[0;48;2;39;40;34m \u001b[0;38;2;248;248;242;48;2;39;40;34mjq [FILE] -f '[*].items[*].id'  through any number of levels at once; -f ..id finds id at any \u001b[0;48;2;39;40;34m    \r\u001b[99C\u001b[0;38;2;122;92;153m\u2502\u001b[0m\r\r\n\u001b[0;48;2;39;40;34m \u001b[0;38;2;248;248;242;48;2;39;40;34mdepth\u001b[0;48;2;39;40;34m                                                                                             \r\u001b[99C\u001b[0;38;2;122;92;153m\u2502\u001b[0m\r\r\n\u001b[0;48;2;39;40;34m \u001b[0;38;2;248;248;242;48;2;39;40;34mjq [FILE] -R KEY                every KEY at any depth, wherever it is\u001b[0;48;2;39;40;34m     