[23.752456, "o", "\u001b[?1049h\u001b[H\u001b[?2004h\u001b[?1l\u001b[?25l\u001b[0m\u001b[?7l\u001b[0m\u001b[J\u001b[0m                                                \u001b[0;38;5;197;1mgrep\u001b[0m\r\r\r\n\r\r\r\n\u001b[0mSearch stdin or FILEs for lines matching a Python regular expression. Matches are highlighted on\u001b[0m\r\r\r\n\u001b[0mscreen. Piped or redirected output is plain text.\u001b[0m\r\r\r\n\r\r\r\n\u001b[0;38;5;200;1;4mOptions\u001b[0m\r\r\r\n\r\r\r\n\u001b[0;36m                                                          \u001b[0m\r\r\r\n\u001b[0;36m Option\u001b[0;1m \u001b[0;36m Meaning\u001b[0;1m                                         \u001b[0;36m \u001b[0m\r\r\r\n\u001b[0;36m ──────────────────────────────────────────────────────── \u001b[0m\r\r\r\n\u001b[0;36m \u001b[0;38;5;49;1m-i\u001b[0m     \u001b[0;36m \u001b[0mIgnore case.                                    \u001b[0;36m \u001b[0m\r\r\r\n\u001b[0;36m \u001b[0;38;5;49;1m-v\u001b[0m     \u001b[0;36m \u001b[0mSelect lines that do \u001b[0;1mnot\u001b[0m match.                 \u001b[0;36m \u001b[0m\r\r\r\n\u001b[0;36m \u001b[0;38;5;49;1m-c\u001b[0m     \u001b[0;36m \u001b[0mPrint only a count of matching lines (per file).\u001b[0;36m \u001b[0m\r\r\r\n\u001b[0;36m \u001b[0;38;5;49;1m-n\u001b[0m     \u001b[0;36m \u001b[0mPrefix each line with its line number.          \u001b[0;36m \u001b[0m\r\r\r\n\u001b[0;36m \u001b[0;38;5;49;1m-F\u001b[0m     \u001b[0;36m \u001b[0mTreat PATTERN as a literal string.              \u001b[0;36m \u001b[0m\r\r\r\n\u001b[0;36m \u001b[0;38;5;49;1m-l\u001b[0m     \u001b[0;36m \u001b[0mPrint only the names of files with a match.     \u001b[0;36m \u001b[0m\r\r\r\n\u001b[0;36m \u001b[0;38;5;49;1m-m N\u001b[0m   \u001b[0;36m \u001b[0mStop after N matches (per file).                \u001b[0;36m \u001b[0m\r\r\r\n\u001b[0;36m                                                          \u001b[0m\r\r\r\n\r\r\r\n\u001b[0mWith several FILEs, each line is prefixed with \u001b[0;38;5;49;1mfile:\u001b[0m. No match gives empty output, which is not an\u001b[0m\r\r\r\n\u001b[0merror.\u001b[0m\r\r\r\n\r\r\r\n\u001b[0;38;5;200;1;4mExamples\u001b[0m\r\r\r\n\r\r\r\n\u001b[0;48;5;235m                                                                                                   \r\u001b[99C \u001b[0m\r\r\r\n\u001b[0;48;5;235m \u001b[0;38;5;255;48;5;235mgrep -i error app.log\u001b[0;48;5;235m                                                                             \r\u001b[99C \u001b[0m\r\r\r\n\u001b[0;48;5;235m \u001b[0;38;5;255;48;5;235mcat app.log | grep -v DEBUG | grep -c timeout\u001b[0;48;5;235m                                                     \r\u001b[99C \u001b[0m\r\r\r\n\u001b[0;48;5;235m \u001b[0;38;5;255;48;5;235mgrep -l TODO main.py core/shell.py\u001b[0;48;5;235m                                                                \r\u001b[99C \u001b[0m\r\r\r\n\u001b[0;48;5;235m                                                                                                   \r\u001b[99C \u001b[0m\r\r\r\n\r\r\r\n\u001b[0;3mShellCraft built-in command.\u001b[0m\r\r\r\n\u001b[0;38;5;16;48;5;200;1m lines 1-31/31 (100%) \u001b[0;38;5;16;48;5;200m ↑↓ scroll  PgUp/PgDn page  g/G top/end  / search  n/N next/prev  q quit     \r\u001b[99C \r\u001b[31A\u001b[0m\u001b[?12l\u001b[?25h"]
